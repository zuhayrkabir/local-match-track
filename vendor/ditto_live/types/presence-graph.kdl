meta {
  version "0.1.12"
}

defaults {
  class {
    annotations r#"
      @immutable
      @external
    "#

    builder-annotations r#"
      @external
    "#
  }
}

preamble r#"
  // ignore_for_file: avoid_bool_literals_in_conditional_expressions, ditto_missing_visibility, require_trailing_commas, unnecessary_lambdas
  // WARNING: DO NOT EDIT - generated from `types/presence-graph.kdl`
  import "package:meta/meta.dart";

  import "../analysis/annotations.dart";
  import "../ditto.dart";
  import "presence.dart";
"#

class "PresenceGraph" {
  docs "Graph of all known peers generated by [Presence] methods."

  field "localPeer" type="Peer" {
    docs "The local peer."
  }

  field "remotePeers" type="Set<Peer>" {
    docs r#"
Note that the peers in this set might not be directly connected to the local
peer. Some peers might be be connected indirectly via a another peer or even
form part of an isolated graph.

Others yet might be discovered but disconnected due to version
incompatibilities.
    "#
  }
}

class "Peer" {
  docs "Peer in the Ditto mesh."

  field "peerKey" type="String" {
    json-key "peerKeyString"
    docs r#"
The peer key is a unique identifier for a given peer, equal to or derived from
the cryptographic public key used to authenticate it.

NOTE: This will be empty when a peer is not updated to the latest version of
the SDK.
    "#
  }

  field "deviceName" type="String" {
    docs r#"
The human-readable device name for a peer. This defaults to the hostname but
can be manually set by the application developer.
    "#
  }

  field "os" type="String?" {
    docs "The operating system of a peer (if known)."
  }

  field "isConnectedToDittoServer" type="bool" {
    json-key "isConnectedToDittoCloud"
    docs r#"
Flag which indicates if this peer is connected to a Ditto Server (Big Peer).
This is represented as a simple flag since attempting to add a server as a node
to a graph would be extremely convoluted. The presence viewer depicts the
server connection with a simple cloud icon above a peer.

Formerly known as `isConnectedToDittoCloud` (deprecated).
    "#
  }

  field "isCompatible" type="bool?" {
    docs r#"
A simplified boolean flag indicating whether the is peer is compatible with our
own peer (if known). Note that there _might_ be connections to this peer even
if incompatible with our own peer, provided that some other peers are able to
interoperate.
    "#
  }

  field "dittoSdkVersion" type="String?" {
    docs "The Ditto SDK version the peer is running with."
  }

  field "connections" type="List<Connection>" {
    docs "List of current connections between this peer and other peers."
  }

  field "peerMetadata" type="Map<String, dynamic>" {
    defaults-to-dart "const {}"
    docs "Metadata assicoated with the peer."
  }

  field "identityServiceMetadata" type="Map<String, dynamic>" {
    defaults-to-dart "const {}"
    docs r#"
Metadata associated with the peer by the identity service.

Use an authentication webhook to set this value. See Ditto's online
documentation for more information on how to configure an authentication
webhook.
    "#
  }
}

class "Connection" {
  docs "Represents a connection between two peers in a Ditto mesh network."

  field "id" type="String" {
    docs r#"
Unique identifier for the connection.

This ID is deterministic for any two peers and a given connection type.

e.g. `1<->2:Bluetooth`
    "#
  }

  field "peer1" type="String" {
    json-key "peerKeyString1"
    docs r#"
The peer key of the peer at one end of the connection.

The assignment to [peer1] and [peer2] is deterministic and stable for any two
peers.
    "#
  }

  field "peer2" type="String" {
    json-key "peerKeyString2"
    docs r#"
The peer key of the peer at the other end of the connection.

The assignment to [peer1] and [peer2] is deterministic and stable for any two
peers.
    "#
  }

  field "connectionType" type="ConnectionType" {
    docs "Type of transport enabling this connection."
  }
}

enum "ConnectionType" {
  annotations "@external"

  docs r#"
The type of [Connection] between two [Ditto] peers, signalling what transport
is being used for it.
  "#

  // we can probably handle the json stuff with just a default-case, but I'm
  // being cautious because we've got this enum wrong loads of times
  variant "bluetooth" { json-value "Bluetooth"; }
  variant "accessPoint" { json-value "AccessPoint"; }
  variant "p2pWifi" { json-value "P2PWiFi"; }
  variant "webSocket" { json-value "WebSocket"; }
  variant "multicast" {
    json-value "Multicast"
    docs r#"
Represents a reliable UDP multicast connection (in beta). This transport should
only be enabled in coordination with Ditto support.
    "#
  }
}
